            "description": "Accepted"
          }
        }
      }
    },
    "/voice/internal/final": {
      "post": {
        "description": "Reference only, not deployed. See reference.md for atomic validation and activation gates. Expired/revoked lease always denied before duplicate detection. 410 does not prove earlier commit failed; never replay provider work or effects. Browser authorized recovery only within original TTL.",
        "security": [
          {
            "adapter": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "lease_id",
                  "request_id",
                  "seq",
                  "type",
                  "state"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "enum": [
                      1
                    ]
                  },
                  "lease_id": {
                    "type": "string"
                  },
                  "request_id": {
                    "type": "string"
                  },
                  "seq": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "done"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "done",
                      "blocked"
                    ]
                  },
                  "transcript_text": {
                    "type": "string"
                  },
                  "answer_text": {
                    "type": "string"
                  },
                  "error_code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New terminal final committed"
          },
          "400": {
            "description": "Malformed"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Origin/consent/scope"
          },
          "404": {
            "description": "Unknown/not-owned"
          },
          "409": {
            "description": "Replay/sequence/final conflict"
          },
          "410": {
            "description": "Expired/revoked"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Unavailable fail closed"
          },
          "200": {
            "description": "Exact duplicate acknowledged only while original lease/session remains live and scoped adapter is valid"
          }
        }
      }
    },
    "/voice/result": {
      "get": {
        "security": [
          {
            "canonical": []
          }
        ],
        "parameters": [
          {
            "name": "request_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "410": {
            "description": "Owned result recovery TTL expired"
          },
          "200": {
            "description": "Owner/session/conversation-bound read-only final recovery,300s TTL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "request_id",
                    "conversation_id",
                    "state",
                    "events",
                    "expires_at"
                  ],
                  "properties": {
                    "version": {
                      "type": "integer"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "conversation_id": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "expires_at": {
                      "type": "number",
                      "description": "Finite UTC Unix seconds from canonical server/database clock; fractional seconds allowed; never ISO string/NaN/Infinity."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Canonical authentication absent, expired or revoked"
          },
          "403": {
            "description": "Exact origin rejected"
          },
          "404": {
            "description": "Unknown or not owned by current owner/session/conversation; no existence leak"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "canonical": {
        "type": "http",
        "scheme": "bearer"
      },
      "adapter": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
