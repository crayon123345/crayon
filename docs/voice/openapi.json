{
  "openapi": "3.1.0",
  "info": {
    "title": "Canonical voice adapter reference",
    "version": "1.0.3",
    "description": "Review-only. No live endpoint/consent/activation. Exact HTTPS Origin + ticket binding, no native or UA exception. Lost-final-response ruling: deny after expiry/revocation, ambiguous commit resolved only by authorized read-only recovery. Revision4 requires lease echo and finite numeric UTC Unix seconds for wire expires_at."
  },
  "paths": {
    "/voice/session": {
      "post": {
        "description": "Reference only, not deployed. See reference.md for atomic validation and activation gates.",
        "security": [
          {
            "canonical": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "conversation_id",
                  "mode",
                  "provider_consent_version"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "enum": [
                      1
                    ]
                  },
                  "conversation_id": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "transcribe",
                      "speak",
                      "live"
                    ]
                  },
                  "provider_consent_version": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "ticket",
                    "request_id",
                    "conversation_id",
                    "mode",
                    "expires_at",
                    "expires_in",
                    "audio_limits",
                    "revalidate_seconds",
                    "recovery_seconds"
                  ],
                  "properties": {
                    "version": {
                      "type": "integer"
                    },
                    "ticket": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "conversation_id": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string"
                    },
                    "expires_at": {
                      "type": "number",
                      "description": "Finite UTC Unix seconds from canonical server/database clock; fractional seconds allowed; never ISO string/NaN/Infinity."
                    },
                    "expires_in": {
                      "type": "integer"
                    },
                    "audio_limits": {
                      "type": "object",
                      "required": [
                        "max_seconds",
                        "max_bytes"
                      ],
                      "properties": {
                        "max_seconds": {
                          "type": "number",
                          "maximum": 600
                        },
                        "max_bytes": {
                          "type": "integer",
                          "maximum": 20000000
                        }
                      }
                    },
                    "revalidate_seconds": {
                      "type": "integer"
                    },
                    "recovery_seconds": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Origin/consent/scope"
          },
          "404": {
            "description": "Unknown/not-owned"
          },
          "409": {
            "description": "Replay/sequence/final conflict"
          },
          "410": {
            "description": "Expired/revoked"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Unavailable fail closed"
          }
        }
      }
    },
