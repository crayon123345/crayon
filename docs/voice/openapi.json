    "/voice/internal/progress": {
      "post": {
        "description": "Reference only, not deployed. See reference.md for atomic validation and activation gates.",
        "security": [
          {
            "adapter": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "lease_id",
                  "seq",
                  "type",
                  "state"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "enum": [
                      1
                    ]
                  },
                  "lease_id": {
                    "type": "string"
                  },
                  "seq": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "accepted",
                      "progress",
                      "transcript_partial",
                      "transcript_final",
                      "answer_partial",
                      "answer_final",
                      "review_required",
                      "artifact",
                      "blocked",
                      "done"
                    ],
                    "description": "Component progress event only, never atomic terminal final commit; final components eligible for short recovery, partials ephemeral."
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "queued",
                      "running",
                      "awaiting_review",
                      "blocked",
                      "done"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Malformed"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Origin/consent/scope"
          },
