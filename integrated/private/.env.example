# Crayon runtime settings. Copy to .env for local runs, or set these on your host (Render).
# Never commit real values.

# --- Required ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
GEMINI_API_KEY=              # Google AI Studio key
DATABASE_URL=                # Neon Postgres connection string

# --- Needed for /selftest ---
CRAYON_ADMIN_TOKEN=          # Bearer token that guards POST /selftest (it returns 403 without it)

# --- Recommended ---
TAVILY_API_KEY=              # web search; without it Crayon falls back to DuckDuckGo, Mojeek, Wikipedia

# --- Optional (defaults shown) ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
CRAYON_TZ=Asia/Kolkata       # default timezone for reminders
CRAYON_MODE=polling
CRAYON_PUBLIC_URL=https://crayon-v1.onrender.com
CRAYON_HISTORY_TURNS=14      # chat turns kept in the prompt
CRAYON_DAILY_CAP=80          # messages per user per day
CRAYON_VERIFY=1              # 1 = one-pass self-check on factual answers, 0 = off
# PORT is set by Render; locally it defaults to 10000

# M13 foundation, disabled until all fields are safely configured. Never put real values in this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- WhatsApp channel (optional). Same Crayon, second channel. See WHATSAPP_SETUP.md ---
WHATSAPP_ACCESS_TOKEN=       # Meta temporary token (about 24h) or a system-user token
WHATSAPP_APP_SECRET=         # Meta app secret, used to check every webhook is from Meta
WHATSAPP_VERIFY_TOKEN=       # any string you choose; paste the same one in Meta's webhook box
WHATSAPP_PHONE_NUMBER_ID=       # assigned Meta TEST number only; not a real/paid number
WHATSAPP_GRAPH_VERSION=v25.0
CRAYON_OWNER_WA_ID=                 # allowed sender(s), digits only. Comma list in WHATSAPP_ALLOWED_IDS

# LLM layer (LangChain). Gemini is the default; switch to OpenRouter by setting the provider and key.
LLM_PROVIDER=gemini
LLM_FRAMEWORK=langchain
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=

# Separate OAuth app for Workspace. Does not replace college Gmail/calendar.
# Add redirect: /connections/workspace/callback on CRAYON_PUBLIC_URL.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
# GitHub public-repo/identity only. Add /connections/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Web frontend is static on Pages; Telegram OIDC secrets stay server-side.
CRAYON_WEB_ORIGIN=https://itsppm76.github.io
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
CRAYON_WEB_ENCRYPTION_KEY=

# Google login only: separate client, openid/email/profile, no Gmail/Workspace scopes
GOOGLE_WEB_LOGIN_CLIENT_ID=
GOOGLE_WEB_LOGIN_CLIENT_SECRET=
